{
  "name": "not-govuk-template-react-router",
  "description": "A React Router Framework application with NotGovUK components.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./dist/server/index.js",
    "test:functional": "cypress run ${CYPRESS_PROJECT_ID:+--record ${CYPRESS_FLAGS}}",
    "test:functional:ci": "start-server-and-test 'start' 'http-get://localhost:3000/' test:functional",
    "clean": "rm -rf dist",
    "cypress": "cypress open",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@not-govuk/components": "0.19.0",
    "@react-router/fs-routes": "8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cypress": "15.18.1",
    "sass-embedded": "1.100.0",
    "start-server-and-test": "3.0.12",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
